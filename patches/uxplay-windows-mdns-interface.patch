+static BOOL CALLBACK brand_renderer_window(HWND window, LPARAM unused) {
+    (void) unused;
+    DWORD process_id = 0;
+    GetWindowThreadProcessId(window, &process_id);
+    if (process_id != GetCurrentProcessId() || !IsWindowVisible(window)) {
+        return TRUE;
+    }
+
+    wchar_t title[256] = { 0 };
+    GetWindowTextW(window, title, sizeof(title) / sizeof(title[0]));
+    std::wstring normalized_title(title);
+    std::transform(normalized_title.begin(), normalized_title.end(),
+                   normalized_title.begin(), towlower);
+    if (normalized_title.find(L"renderer") == std::wstring::npos &&
+        normalized_title.find(L"direct3d") == std::wstring::npos) {
+        return TRUE;
+    }
+
+    static HICON large_icon = (HICON) LoadImageW(
+        GetModuleHandleW(NULL), MAKEINTRESOURCEW(1), IMAGE_ICON,
+        GetSystemMetrics(SM_CXICON), GetSystemMetrics(SM_CYICON), LR_DEFAULTCOLOR);
+    static HICON small_icon = (HICON) LoadImageW(
+        GetModuleHandleW(NULL), MAKEINTRESOURCEW(1), IMAGE_ICON,
+        GetSystemMetrics(SM_CXSMICON), GetSystemMetrics(SM_CYSMICON), LR_DEFAULTCOLOR);
+
+    SetWindowTextW(window, L"Local Play Viewer");
+    if (large_icon) {
+        SendMessageW(window, WM_SETICON, ICON_BIG, (LPARAM) large_icon);
+    }
+    if (small_icon) {
+        SendMessageW(window, WM_SETICON, ICON_SMALL, (LPARAM) small_icon);
+    }
+    return TRUE;
+}
+
+static gboolean brand_renderer_windows(gpointer unused) {
+    (void) unused;
+    EnumWindows(brand_renderer_window, 0);
+    return G_SOURCE_CONTINUE;
+}
+#endif
+
 static void main_loop()  {
     guint gst_video_bus_watch_id[MAX_VIDEO_RENDERERS] = { 0 };
     guint gst_audio_bus_watch_id[MAX_AUDIO_RENDERERS] = { 0 };
@@ -721,2 +766,4 @@ static void main_loop()  {
